# Database Configuration
# Get your PostgreSQL connection string from Neon (https://neon.tech)
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Session Secret
# Generate a unique secret with: openssl rand -base64 32
SESSION_SECRET=""

# Application Domain
# Local development default; set this to your deployed site origin in production.
NEXT_PUBLIC_DOMAIN="http://localhost:3000"

# Canonical origin used by MCP OAuth and Host validation.
# Keep localhost for local development. Production must set its canonical HTTPS origin.
MCP_BASE_URL="http://localhost:3000"

# User Profile (Optional)
# Display name shown on the homepage and browser title
NEXT_PUBLIC_USERNAME="Your Name Here"

# Logo Configuration (Optional)
# Logo filename in the /public directory
# Place your logo.jpg or logo.png in the public folder
NEXT_PUBLIC_LOGO="logo.jpg"

# PPT Generator API Configuration (For Admin Generations Dashboard)
# Base URL of the external PPT Generator API
NEXT_PUBLIC_PPT_API_URL="Your PPT API URL here (e.g., https://api.yourpptgenerator.com)"

# PPT API Admin Key (Optional - only if your PPT API requires authentication)
# Uncomment and set if the API endpoint requires authentication
# PPT_ADMIN_API_KEY="your-api-key-here"
